# Local-only examples. Replace all credentials for production; use HTTPS APP_ORIGIN.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:58080
POSTGRES_PASSWORD=local-database-password
DATABASE_URL=postgresql://design_qa:local-database-password@127.0.0.1:55432/design_qa_dev
MINIO_ENDPOINT=http://127.0.0.1:59000
MINIO_BUCKET=design-qa-dev
MINIO_ACCESS_KEY=local-minio-access
MINIO_SECRET_KEY=local-minio-secret-password
SESSION_SIGNING_KEY=local-only-signing-key-32-characters
CAPTURE_ENABLED=false

# Exact operator-approved capture origins; empty denies all URL saves.
CAPTURE_ALLOWED_ORIGINS=https://example.com,http://localhost:58080
# Optional safe metadata only. Secrets are configured later with capture.
CAPTURE_PROFILES_METADATA=[]
