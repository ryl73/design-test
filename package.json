{
  "name": "design-qa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test:e2e": "playwright test --config playwright.config.ts --grep-invert @integration",
    "test:unit": "vitest run --config vitest.config.ts",
    "start": "vite",
    "test:integration": "playwright test --config playwright.config.ts --grep @integration",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.4"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.5.0",
    "pixelmatch": "7.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
